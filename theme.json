{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "base",
					"name": "White (background)",
					"color": "#FFFFFF"
				},
				{
					"slug": "card",
					"name": "Blush (cards)",
					"color": "#FFF4F8"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#151115"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#6B6170"
				},
				{
					"slug": "line",
					"name": "Hairline",
					"color": "#EFE3EA"
				},
				{
					"slug": "plum",
					"name": "Kitchenmess plum",
					"color": "#763978"
				},
				{
					"slug": "pink",
					"name": "Kitchenmess pink",
					"color": "#F287B7"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(3rem, 6vw, 4.5rem)"
				},
				{
					"slug": "60",
					"name": "2XL",
					"size": "clamp(4rem, 8vw, 6.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Montserrat",
					"fontFamily": "Montserrat, Gotham, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Montserrat",
							"fontWeight": "800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-800-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "accent",
					"name": "Cormorant Garamond Italic",
					"fontFamily": "\"Cormorant Garamond\", Garamond, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "500",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-500-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Label",
					"size": "0.6875rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Card title",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Section heading",
					"size": "4rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "7.75rem",
					"fluid": {
						"min": "3.25rem",
						"max": "7.75rem"
					}
				}
			]
		},
		"custom": {
			"radius": "22px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1.125rem, 4vw, 2rem)",
				"right": "clamp(1.125rem, 4vw, 2rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "800",
					"lineHeight": "0.98",
					"letterSpacing": "-0.035em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "0.9",
					"letterSpacing": "-0.05em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|plum"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "999px",
					"width": "2px",
					"style": "solid",
					"color": "var:preset|color|ink"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.625rem",
						"right": "1.625rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.875rem",
					"fontWeight": "600",
					"letterSpacing": "0.02em",
					"textTransform": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|pink",
						"text": "var:preset|color|ink"
					},
					"border": {
						"color": "var:preset|color|pink"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				},
				"border": {
					"width": "1px 0 0 0"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "600",
					"letterSpacing": "0",
					"textTransform": "none"
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var:preset|font-size|label",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|label",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|accent",
					"fontStyle": "italic",
					"fontSize": "1.625rem"
				},
				"border": {
					"left": {
						"color": "var:preset|color|pink",
						"width": "4px"
					}
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|line",
						"width": "1px",
						"style": "solid"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "22px"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "22px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}