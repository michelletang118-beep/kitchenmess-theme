{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{ "slug": "blush", "name": "Blush white (background)", "color": "#FCF9FA" },
				{ "slug": "card", "name": "Card", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#2B2230" },
				{ "slug": "muted", "name": "Muted text", "color": "#6E6470" },
				{ "slug": "line", "name": "Hairline", "color": "#EBDFE6" },
				{ "slug": "plum", "name": "Kitchenmess plum", "color": "#763978" },
				{ "slug": "pink", "name": "Kitchenmess pink", "color": "#F287B7" },
				{ "slug": "pink-wash", "name": "Pink wash", "color": "#FBE3EE" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1160px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3rem, 6vw, 4.5rem)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(4rem, 8vw, 6.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Garamond, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-300-normal.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "300", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-300-italic.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-400-normal.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-400-italic.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-500-normal.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Montserrat",
					"fontFamily": "Montserrat, Gotham, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-300-normal.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "300", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-300-italic.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-400-normal.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-500-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "label", "name": "Label", "size": "0.6875rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1rem", "fluid": false },
				{ "slug": "lede", "name": "Lede", "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "x-large", "name": "Section heading", "size": "3.25rem", "fluid": { "min": "2.125rem", "max": "3.375rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "6.25rem", "fluid": { "min": "3.25rem", "max": "6.5rem" } }
			]
		},
		"custom": {
			"letterSpacing": { "label": "0.2em" }
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|blush", "text": "var:preset|color|ink" },
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "300",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "clamp(1.125rem, 4vw, 2rem)", "right": "clamp(1.125rem, 4vw, 2rem)" }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "400", "lineHeight": "1.08" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "300", "lineHeight": "1" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "1.375rem" } },
			"link": {
				"color": { "text": "var:preset|color|plum" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|ink" } }
			},
			"button": {
				"color": { "background": "var:preset|color|plum", "text": "var:preset|color|white" },
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var:preset|color|plum" },
				"spacing": { "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.625rem", "right": "1.625rem" } },
				"typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "0.75rem", "fontWeight": "400", "letterSpacing": "0.18em", "textTransform": "uppercase" },
				":hover": { "color": { "background": "var:preset|color|ink" }, "border": { "color": "var:preset|color|ink" } }
			},
			"caption": { "typography": { "fontSize": "var:preset|font-size|small", "fontStyle": "italic" }, "color": { "text": "var:preset|color|muted" } }
		},
		"blocks": {
			"core/separator": { "color": { "text": "var:preset|color|line" }, "border": { "width": "1px 0 0 0" } },
			"core/post-title": { "typography": { "fontWeight": "300" } },
			"core/navigation": { "typography": { "fontSize": "0.75rem", "letterSpacing": "0.18em", "textTransform": "uppercase", "fontWeight": "400" } },
			"core/site-title": { "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "2.125rem", "fontWeight": "500", "lineHeight": "1" }, "elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var:preset|color|ink" } } } },
			"core/post-date": { "typography": { "fontSize": "var:preset|font-size|label", "letterSpacing": "0.2em", "textTransform": "uppercase" }, "color": { "text": "var:preset|color|muted" } },
			"core/post-terms": { "typography": { "fontSize": "var:preset|font-size|label", "letterSpacing": "0.2em", "textTransform": "uppercase" } },
			"core/quote": { "typography": { "fontFamily": "var:preset|font-family|display", "fontStyle": "italic", "fontSize": "1.5rem" }, "border": { "left": { "color": "var:preset|color|pink", "width": "1px" } } },
			"core/details": { "border": { "bottom": { "color": "var:preset|color|line", "width": "1px", "style": "solid" } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page (no title)", "postTypes": [ "page" ] }
	]
}
